# =============================================================================
# MonTra — Local Development Environment Configuration (.env.example)
# Copy this file to `.env` for local development.
# NEVER commit real credentials, tokens, or secrets to version control.
# =============================================================================

# Application Environment (development | test | staging | production)
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL Database (Source of Truth)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=montra_dev
POSTGRES_USER=montra_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_DB_PASSWORD
POSTGRES_SSLMODE=disable

# Optional explicit DSN override for services/api when running outside Docker:
# DATABASE_URL=postgres://montra_app:CHANGE_ME_LOCAL_DEV_DB_PASSWORD@localhost:5432/montra_dev?sslmode=disable

# -----------------------------------------------------------------------------
# Golang Primary Backend (services/api)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
API_READ_TIMEOUT_MS=5000
API_WRITE_TIMEOUT_MS=10000
API_SHUTDOWN_TIMEOUT_MS=10000
DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE=Asia/Jakarta

# Authentication placeholder (used beginning in Phase 1)
JWT_SECRET=CHANGE_ME_GENERATE_32_BYTE_MINIMUM_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Internal AI/ML Communication (Go -> Python FastAPI)
# -----------------------------------------------------------------------------
ML_ENABLED=true
ML_SERVICE_BASE_URL=http://ml:8000
ML_CLIENT_TIMEOUT_MS=1500
ML_CATEGORY_CONFIDENCE_THRESHOLD=0.75
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_SHARED_TOKEN

# -----------------------------------------------------------------------------
# Python FastAPI AI/ML Service (services/ml)
# -----------------------------------------------------------------------------
ML_HOST=0.0.0.0
ML_PORT=8000
ML_MODEL_ARTIFACTS_DIR=/app/artifacts
ML_CATEGORY_MODEL_VERSION=untrained-v0

# -----------------------------------------------------------------------------
# Reverse Proxy (infrastructure/proxy)
# -----------------------------------------------------------------------------
PROXY_HTTP_PORT=8088
